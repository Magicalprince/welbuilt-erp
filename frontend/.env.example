# Firebase Configuration (client — safe to expose, real access control is via Firestore Security Rules)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare R2 — non-secret identifiers only (client).
# The bucket hostname/name, not credentials — existing stored file URLs use
# this format, so these stay client-side even though they're VITE_-prefixed.
VITE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
VITE_R2_BUCKET_NAME=your_bucket_name
VITE_R2_PUBLIC_URL=

# --- Everything below is server-only: NEVER prefix with VITE_, or Vite will
# --- inline it into the public JS bundle shipped to every visitor's browser.

# Cloudflare R2 credentials — used only by api/r2-presign.ts to sign URLs.
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Firebase Admin service account — used only by api/r2-presign.ts to verify
# the caller is a logged-in user before signing any R2 URL. Generate via
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare API Token (for other server-side operations)
CLOUDFLARE_API_TOKEN=your_api_token
